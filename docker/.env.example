# Copy this file to .env and fill in the values for whichever dog this
# Jetson belongs to before running `docker compose up`.

# Required. Each Mid-360's IP is tied to its serial number, not the dog --
# if LiDAR units are ever swapped between dogs, update this to match
# whichever physical unit is actually plugged in. See docker/README.md's
# first-live-run section for the known IPs.
LIVOX_LIDAR_IP=192.168.1.137

# Host-side IP the Jetson's eth0 should already have in its persistent
# netplan configuration. Only override this if a given Jetson's LiDAR-subnet
# address genuinely differs from the convention used so far.
LIVOX_HOST_IP=192.168.1.50

# Fast DDS is currently the live-verified Dog 2 path. CycloneDDS remains the
# intended control-stack alignment, but needs a rebuilt-image hardware test.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Safety boundary: leave false for replay and initial stationary tests.
# Enabling publishes Unitree StopMove requests and must be deliberate.
ACTUATION_ENABLED=false

# Experimental detector switches. Leave all false for the established
# baseline. Enable only one at a time for an interpretable A/B test.
USE_OCCLUSION_ACCUMULATION=false
USE_FREE_SPACE_DETECTION=false
USE_TEMPORAL_CONSENSUS=false
TEMPORAL_HISTORY_FRAMES=3
TEMPORAL_MIN_CHANGED_RATIO=0.5

# Established baseline uses ten non-overlapping scans. The occlusion and
# free-space modes require 1/1/5. Temporal consensus is also most useful with
# 1/1/5 when comparing low-latency per-scan approaches.
PERCEPTION_ACCUMULATE_SCANS=10
PERCEPTION_ACCUMULATE_STRIDE=0
PERCEPTION_CLUSTER_MIN_POINTS=10

# Raw field-bag recording (`--profile record`). Use a persistent absolute
# host path on each Jetson and a new, descriptive name for every scene.
RECORD_OUTPUT_DIR=/home/unitree/lidar-bags
RECORD_NAME=replace-me-before-recording

# Optional inter-dog track exchange (only used with --profile shared).
# Give each dog a unique DOG_ID and the other dog's WiFi/AP or Tailscale IP.
DOG_ID=dog1
PEER_DOG_ID=dog2
TRACK_EXCHANGE_ENABLED=false
TRACK_PEER_HOST=
TRACK_EXCHANGE_PORT=47020
# Set the same non-empty secret on both dogs before enabling exchange.
TRACK_SHARED_SECRET=
# Every dog must express both sources in the same chosen shared frame.
# Example on dog 1: local identity; measured dog2 -> dog1 transform remote.
LOCAL_TO_SHARED=0,0,0,0
REMOTE_TO_SHARED=0,0,0,0
