# Copy this file to .env and fill in the values for whichever dog this
# Jetson belongs to before running `docker compose up`.

# Required. Each Mid-360's IP is tied to its serial number, not the dog --
# if LiDAR units are ever swapped between dogs, update this to match
# whichever physical unit is actually plugged in. See docker/README.md's
# first-live-run section for the known IPs.
LIVOX_LIDAR_IP=192.168.1.137

# Host-side IP the Jetson's eth0 should already have configured (see
# go2-jetson-setup.md section 4/7 for the netplan setup). Only override this
# if a given Jetson's LiDAR-subnet address genuinely differs from the
# convention used so far.
LIVOX_HOST_IP=192.168.1.50

# Safety boundary: leave false for replay and initial stationary tests.
# Enabling publishes Unitree StopMove requests and must be deliberate.
ACTUATION_ENABLED=false
